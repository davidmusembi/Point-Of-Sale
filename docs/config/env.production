# =============================================================================
# ultimatePOS — Production Environment Template
# Copy to /var/www/pos/.env and fill in real values.
# Never commit the actual .env to version control.
# =============================================================================

APP_NAME="ultimatePOS"
APP_ENV=production
APP_KEY=                        # php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com

# The base domain used for tenant subdomain assignment.
# Tenants are provisioned as {slug}.APP_DOMAIN
APP_DOMAIN=yourdomain.com

# ---------------------------------------------------------------------------
# Database — Central
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1               # or managed DB IP
DB_PORT=3306
DB_DATABASE=afipos_central
DB_USERNAME=afipos_user
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Database — Tenant (connection template; host/port/user match central)
# stancl/tenancy swaps the database name per request automatically.
# ---------------------------------------------------------------------------
TENANCY_DB_HOST=127.0.0.1
TENANCY_DB_PORT=3306
TENANCY_DB_USERNAME=afipos_user
TENANCY_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cache / Session / Queue
# ---------------------------------------------------------------------------
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                 # set a password in redis.conf

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Trusted Proxies (Cloudflare or load balancer)
# Set to * only if behind Cloudflare with origin lock enforced in Nginx.
# ---------------------------------------------------------------------------
TRUSTED_PROXIES=*
TRUSTED_HOSTS="yourdomain.com,*.yourdomain.com"

# ---------------------------------------------------------------------------
# Superadmin & Registration
# ADMINISTRATOR_USERNAMES: comma-separated usernames that bypass to superadmin panel.
# Must match the username created by SuperadminUserSeeder (SUPERADMIN_USERNAME).
# ALLOW_REGISTRATION: set false on production; businesses are provisioned via superadmin.
# ---------------------------------------------------------------------------
ADMINISTRATOR_USERNAMES=admin
ALLOW_REGISTRATION=false

# Credentials used by SuperadminUserSeeder (php artisan db:seed).
# Change SUPERADMIN_PASSWORD immediately after first login.
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# Payment Gateways
# ---------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live                # sandbox | live

RAZORPAY_KEY=
RAZORPAY_SECRET=

PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_LIVE=true

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Storage backup (S3 / Spaces / R2)
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=                   # leave blank for AWS; set for DO Spaces or R2

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAYS=14
