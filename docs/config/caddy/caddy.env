# =============================================================================
# Caddy environment file
# Place at: /etc/caddy/caddy.env
# Reference in systemd unit: EnvironmentFile=/etc/caddy/caddy.env
# Permissions: chmod 600 /etc/caddy/caddy.env
# =============================================================================

# Cloudflare API token — needs Zone:DNS:Edit permission for your domain.
# Create at: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=your_cloudflare_api_token_here
