# =============================================================================
# Caddy environment file
# Place at: /etc/caddy/caddy.env
# Reference in systemd unit: EnvironmentFile=/etc/caddy/caddy.env
# Permissions: chmod 600 /etc/caddy/caddy.env
# =============================================================================

# Cloudflare API token — needs Zone:DNS:Edit permission for your domain.
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Used by:
#   - Caddy: DNS-01 ACME challenge for wildcard TLS cert (*.nairobyte.xyz)
#   - Laravel: CreateCloudflareDnsRecord job (per-tenant A record on provisioning)
CF_API_TOKEN=your_cloudflare_api_token_here

# Zone ID for your domain — found in Cloudflare dashboard → Overview → right sidebar.
# Used by Laravel's CreateCloudflareDnsRecord job.
CF_ZONE_ID=your_zone_id_here

# Public IP of this server — what tenant A records point to.
# Must match the IP in your Cloudflare A / *.yourdomain.com record.
SERVER_IP=your_server_ip_here
